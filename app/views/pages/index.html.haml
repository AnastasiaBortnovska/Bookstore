%main.container
  #slider.carousel.slide{'data-ride': "carousel"}
    %ol.carousel-indicators
      - @latest_books.each_with_index do |_book, index|
        %li{class: " #{'active' if index.zero?}", 'data-target': "#slider", 'data-slide-to': "#{index}"}
    .carousel-inner{role: "listbox"}
      - @latest_books.each_with_index do |book, index|
        %div{class: "item #{'active' if index.zero?}"}
          .row
            .col-sm-5
              .general-img-wrap
                =image_tag book.show_cover(:large), class: 'img-shadow.general-thumbnail-img'
            .col-sm-7
              .mb-60
                %h1= book.title
                %p.lead= book.short_description
                %p.lead.small= book.authors_as_string
                .general-align
                  = link_to t('.buttons.buy'), order_books_path(order_book: {book_id: book.id, quantity: 1}), method: :post, class: 'btn btn-primary'
    %a.left.carousel-control{href: "#slider", role: "button", 'data-slide': "prev"}
      %span.icon-prev{'aria-hidden': "true"}
      %span.sr-only Previous
    %a.right.carousel-control{href: "#slider", role: "button", 'data-slide': "next"}
      %span.icon-next{'aria-hidden': "true"}
      %span.sr-only Next
.container
  .jumbotron.text-center.mb-0
    %h2.h1= t('.greeting')
    .mb-res-50
      %p= t('.info')
    = link_to t('.buttons.start'), books_path, class: 'button btn btn-default'
  .mb-35
    %h3= t('.best')
    #best_sellers.row
      = render partial: 'books/partials/book', collection: best_sellers, as: :book
