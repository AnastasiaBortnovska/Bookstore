%main.container.mb-res-50
  = render 'checkout/partials/header'
  %h3.general-subtitle Credit Card
  = simple_form_for @form, url: wizard_path, method: :put, validate: true do |form|
    = form.simple_fields_for @form.credit_card do |f|
      = f.label :number, 'Card Number', class: 'control-label input-label'
      = f.text_field :number, class: 'form-control', placeholder: "Card Number", required: true
      .row
        .col-sm-6
          = f.label :name, 'Name on Card', class: 'control-label input-label'
          = f.text_field :name, class: 'form-control', placeholder: "Name on Card", required: true
        .col-sm-3
          = f.label :expire_date, 'MM / YY', class: 'control-label input-label'
          = f.text_field :expire_date, class: 'form-control', placeholder: "MM / YY", required: true
        .col-sm-3
          = f.label :cvv, 'CVV', class: 'control-label input-label'
          = f.text_field :cvv, class: 'form-control', placeholder: "CVV", required: true
          %i.fa.fa-question-circle.general-form-help
      = render 'checkout/partials/order_summary', order: current_order.decorate
      = form.button :submit, 'button.save_and_continue', class: 'btn btn-default center-block mb-20'
