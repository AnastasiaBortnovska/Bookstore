%main.container.mb-res-50
  = render 'checkout/partials/header'
  = form_tag wizard_path, method: :put, html: {class: 'max-600'} do
    = render 'checkout/partials/order_summary', order: current_order.decorate
    %script.stripe-button{
      "data-amount" => current_order.decorate.total_price * 100,
      "data-email" => current_user.email, 
      "data-key" => Rails.application.credentials.dig(:stripe, :public_api_key), 
      "data-locale" => "auto", 
      :src => "https://checkout.stripe.com/checkout.js"
    }