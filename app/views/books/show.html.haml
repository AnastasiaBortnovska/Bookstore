%main.container
  = link_to request.referer, class: 'general-back-link' do
    %i.fa.fa-long-arrow-left.mr-15
    = t('.buttons.back')
  .row
    .col-sm-6
      .product-gallery
        .mb-20
          =image_tag book.show_cover, class: 'main_cover'
        .images.clearfix
        - if book.images.attached?
          - book.images.each do |image|
            =image_tag image, class: 'img-link images_size'
    .col-sm-6
      %h1.mt-res-0= book.title
      %p.lead.small= book.authors_as_string
      .row
        .col-xs-12.col-md-4
          %p.h1.in-gold-500.mt-10= number_to_currency(book.price)
        .col-xs-5.col-md-3
        = simple_form_for(OrderBook.new, method: :post) do |f|
          .input-group.general-position
            %a.input-link.btn-minus-js
              %i.fa.fa-minus.line-height-40
            = f.number_field :quantity, value: 1, class: 'form-control quantity-input book-quantity-js'
            = f.hidden_field :book_id, value: book.id
            %a.input-link.btn-plus-js
              %i.fa.fa-plus.line-height-40
        .col-xs-7.col-md-5
          %button.btn.btn-default.pull-right.general-position= t('.buttons.add_to_cart')
      .general-info-wrap.divider-lg
        %p= t('.description')
        %p.lead.small.line-height-2
          = book.medium_description
          %span.end-of-description-js{style: 'display:none'}
            = book.all_description
          = button_tag t('.buttons.read_more'), disabled: book.description_less_240?, class: 'btn-link in-gold-500 ml-10 read-more-js'  
      .general-info-wrap.divider-lg
        .clearfix
          %p.pull-left= t('.publication_year')
          %p.lead.small.pull-right
            = book.publication_year
      .general-info-wrap.divider-lg
        .clearfix
          %p.pull-left= t('.dimensions')
          %p.lead.small.pull-right= book.dimensions
      .general-info-wrap.divider-lg
        .clearfix
          %p.pull-left= t('.materials')
          %p.lead.small.pull-right= book.material_as_string
  = render 'reviews/book_reviews'
