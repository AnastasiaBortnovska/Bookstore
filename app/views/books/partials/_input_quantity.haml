.input-group
  = link_to order_book_path(order_iteam, quantity_action: :decrement), class: 'input-link', method: :patch do
    %i.fa.fa-minus.line-height-40
  %input.form-control.quantity-input{value: order_iteam.quantity}
  = link_to order_book_path(order_iteam, quantity_action: :increment), class: 'input-link', method: :patch do
    %i.fa.fa-plus.line-height-40
