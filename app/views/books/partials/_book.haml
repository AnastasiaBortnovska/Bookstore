.col-xs-6.col-sm-3
    .general-thumb-wrap
        .thumbnail.general-thumbnail
            =image_tag book.show_cover(:medium), class: 'cart_cover img-shadow general-thumbnail-img'
            .thumb-hover
                .general-thumb-link-wrap
                    = link_to book_path(id: book), class: 'thumb-hover-link' do
                        %i.fa.fa-eye.thumb-icon{'aria-hidden': "true"}
                    %a.thumb-hover-link{href: "#"}
                        %i.fa.fa-shopping-cart.thumb-icon
    .general-thumb-info
        %p.title= book.title
        %p.font-16.in-gold-500
            = number_to_currency(book.price)
        %span.divider-sm
        %p.lead.small= book.authors_as_string
