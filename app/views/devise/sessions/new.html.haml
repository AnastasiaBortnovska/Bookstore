%main.container.general-main-wrap
  .text-center
    = render 'devise/shared/facebook_authentication', title: t('.log_in')
  .general-form.field
    = simple_form_for(resource, as: resource_name, url: session_path(resource_name), defaults: { input_html: { class: "form-control" }}) do |f|
      .form-group.mb-30
        = f.input :email, autofocus: true, autocomplete: "email", placeholder: t('.email')
      .form-group.mb-30
        = f.input :password, autocomplete: "current-password", placeholder: t('.password')
        = link_to t('.forgot_password'), new_user_password_path, class: 'help-block in-gold-500'
      - if devise_mapping.rememberable?
        .form-group.checkbox.text-center.mb-30
          %label.checkbox-label
            = f.check_box :remember_me, hidden: "true" , class: 'checkbox-input'
            %span.checkbox-icon
              %i.fa.fa-check
            %span.checkbox-text
              = t('.remember_me')
      .text-center
        .actions
          = f.submit t('.log_in'), class: 'btn btn-default mb-20'
  .text-center
    %p.general-sign-text.text-center
      = t('.dont_have_account')
      = link_to t('.sign_up'), new_user_registration_path, class: 'in-gold-500'
