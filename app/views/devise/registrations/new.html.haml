%main.container.general-main-wrap
  .text-center
    = render 'devise/shared/facebook_authentication', title: t('.sign_up')
  .general-form.field
    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), defaults: { input_html: { class: "form-control" },
    wrapper_html: { class: 'form-group mb-30' } }) do |f|
      = f.input :email, autofocus: true, autocomplete: "email", placeholder: t('.email')
      = f.input :password, autocomplete: "current-password", placeholder: t('.password')
      = f.input :confirm_password, autocomplete: "new-password", placeholder: t('.confirm_password')
      .text-center
        .actions
          = f.submit t('.sign_up'), class: 'btn btn-default mb-20'
      .text-center
        %p.general-sign-text.text-center
          = t('.have_account')
        = link_to t('.log_in'), new_session_path(resource_name), class: 'in-gold-500'
