.col-sm-5.email-form
    %p.in-gold-500.font-18.mb-25
        = t('.email')
    = simple_form_for(current_user, as: :user, url: registration_path(:user), method: :put) do |f|
        .form-group.mb-35
            = f.input :email, autocomplete: "email"
        .general-text-align
            = f.button :submit, t('.button_save')
