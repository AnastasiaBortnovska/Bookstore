.col-sm-5.email-form
    %p.in-gold-500.font-18.mb-25
        = t('.email')
    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), method: :patch, html: { class: 'general-form-md' }, defaults: { input_html: { class: "form-control" }}) do |f|
        .form-group.mb-35
            = f.input :email, autocomplete: "email", class: 'form-control', id: 'email', placeholder: t('.email')
        .general-text-align
            = f.button :submit, t('.button_save'), class: 'btn btn-default mb-35'
