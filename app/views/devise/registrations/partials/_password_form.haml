.col-sm-5.col-sm-offset-1
    %p.in-gold-500.font-18.mb-25
        = t('.password')
    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), method: :patch, defaults: { input_html: { class: "form-control" }}) do |f|
        .form-group.mb-30
            = f.input :current_password, class: 'form-control', placeholder: t('.old_password')
        .form-group.mb-30
            = f.input :password, class: 'form-control', placeholder: t('.new_password')
        .form-group.mb-40
            = f.input :password_confirmation, class: 'form-control', placeholder: t('.confirm_password')
        .general-text-align
            = f.button :submit, t('.button_save'), class: 'btn btn-default mb-35'
