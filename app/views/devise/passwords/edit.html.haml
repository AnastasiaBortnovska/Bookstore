%main.container.general-main-wrap
  .text-center.mb-25
    %h2
      = t('.change_password')
  .general-form.field
    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, defaults: { input_html: { class: "form-control" }, 
    wrapper_html: { class: 'form-group mb-30' }, label_html: { class: 'control-label input-label' } }) do |f|
      = f.hidden_field :reset_password_token
      = f.input :password, label: t('.password'), autofocus: true, autocomplete: "new_password", placeholder: t('.new_password')
      = f.input :password_confirmation, label: t('.confirm_new_password'), autocomplete: "off", placeholder: t('.confirm_new_password')
      .text-center
        .actions
          = f.submit t('.btn_change_password'), class: 'btn btn-default mb-20'
