%main.container.general-main-wrap
  .text-center.mb-25
    %h2
      = t('.change_password')
  .general-form.field
    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), method: :put) do |f|
      = f.hidden_field :reset_password_token
      = f.input :password, autofocus: true, autocomplete: 'new_password'
      = f.input :password_confirmation, autocomplete: 'off'
      .text-center
        .actions
          = f.button :submit, t('.btn_change_password'), class: 'btn btn-default mb-20'
