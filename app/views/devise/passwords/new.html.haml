%main.container.general-main-wrap
  .text-center
    %h1.mb-30
      = t('.forgot_password')
    %p.general-password-text
      = t('.forgot_password_description')
  .general-form.field
    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), method: :post) do |f|
      = f.input :email, autofocus: true, autocomplete: 'email'
      .text-center
        .actions
          = f.button :submit, t('.btn_send_password_instructions')
        = link_to t('.cancel'), url_for(:back), class: 'in-gold-500'
