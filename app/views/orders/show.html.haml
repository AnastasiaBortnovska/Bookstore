%main.container.mb-res-50
  #information_block.row.mb-20
    .col-sm-3
      %h3.general-subtitle= t('.shipping_address')
      = render 'orders/partials/address_information', address: @order.shipping_address
    .col-sm-3
      %h3.general-subtitle= t('.billing_address')
      = render 'orders/partials/address_information', address: @order.billing_address
    = render 'orders/partials/delivery_information', delivery: @order.order_delivery.delivery
    = render 'orders/partials/payment_information', credit_card: @order.credit_card
  .visible-xs
    = render partial: 'checkout/partials/confirm/mobile_book_item', collection: @order.order_books, as: :item
  .hidden-xs.divider-lg.pt-20
    = render partial: 'checkout/partials/confirm/book_item', collection: @order.order_books, as: :item
