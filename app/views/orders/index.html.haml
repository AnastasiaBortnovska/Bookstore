%main.container.general-main-wrap
  %h1.mt-0.mb-25= t('.title')
  = render 'orders/partials/filters_list'
  .hidden-xs.mb-res-50
    %table.table.table-hover
      %thead
        %tr
          %th
            %span.in-grey-600
              = t('.table.order_number')
          %th
            %span.in-grey-600
              = t('.table.completed_at')
          %th
            %span.in-grey-600
              = t('.table.status')
          %th
            %span.in-grey-600
              = t('.table.total')
      %tbody
        = render partial: 'orders/partials/order_row', collection: @orders, as: :order
.text-center
  = pagy_bootstrap_nav(@pagy).html_safe
